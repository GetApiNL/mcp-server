{
  "name": "getapi-mcp",
  "description": "MCP-server for GetApi API - exposes GetApi endpoints as MCP tools",
  "version": "0.1.0",
  "command": "npx",
  "args": ["getapi-mcp"],
  "mcpServers": {
    "getapi": {
      "command": "npx",
      "args": ["-y", "getapi-mcp@0.1.0"],
      "env": {
        "API_KEY": "PLACEHOLDER"
      }
    }
  },
  "repository": "https://github.com/GetApiNl/mcp-server",
  "homepage": "https://getapi.nl",
  "keywords": ["mcp", "getapi", "api", "tool", "openapi", "ai"],
  "license": "MIT",
  "platforms": [
    {
      "name": "node",
      "version": ">=20.0.0"
    }
  ],
  "auth": {
    "type": "env-var",
    "var": "API_KEY",
    "required": true,
    "description": "GetApi API key (ga_live_ or ga_test_ prefix)"
  },
  "features": {
    "automaticUpdate": {
      "enabled": true,
      "interval": "1h",
      "description": "Automatically refreshes tools when GetApi spec changes"
    },
    "x402Excluded": {
      "enabled": true,
      "description": "x402 (payment) endpoints excluded"
    }
  },
  "host": "api.getapi.nl",
  "spec": {
    "url": "https://api.getapi.nl/docs/api.json",
    "validated": true
  },
  "timeout": {
    "request": "10s",
    "spec": "10s"
  }
}