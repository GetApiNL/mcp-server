{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "nl.getapi/mcp",
  "title": "GetApi",
  "description": "Nederlandse overheids- en registerdata via MCP: KVK, BAG, energielabel, kenteken, DSO en meer.",
  "version": "1.0.0",
  "websiteUrl": "https://getapi.nl/mcp-server-integratie",
  "repository": {
    "url": "https://github.com/GetApiNL/mcp-server",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.getapi.nl/mcp",
      "headers": [
        {
          "name": "X-Api-Key",
          "description": "API key voor authenticatie",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
